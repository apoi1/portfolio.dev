---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/ui/Icon.astro';
---

<Layout
  title="404 — Signal lost · apoi2"
  description="The page you are looking for drifted out of range."
  locale="en"
>
  <Nav locale="en" />
  <main id="main" class="grid min-h-dvh place-items-center px-4">
    <div class="text-center">
      <p class="font-mono text-[clamp(5rem,18vw,11rem)] leading-none font-bold text-grad">
        404
      </p>
      <h1 class="mt-2 text-2xl font-extrabold tracking-tight text-ink md:text-3xl">
        Signal lost
      </h1>
      <p class="mt-3 text-sm text-soft">
        The page you are looking for drifted out of range.
      </p>
      <p class="mt-1 text-sm text-faint">
        La página que buscas se salió de rango.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="glow-violet inline-flex items-center gap-2 rounded-full bg-violet px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-lilac"
          data-cursor="hover">
          <Icon name="arrow-right" class="size-4 rotate-180" />
          Back home
        </a>
        <a
          href="/es/"
          class="inline-flex items-center gap-2 rounded-full border border-line-strong px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-lilac hover:text-lilac"
          data-cursor="hover">
          Inicio (ES)
        </a>
      </div>
    </div>
  </main>
  <Footer locale="en" />
</Layout>
