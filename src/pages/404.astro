---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/ui/Icon.astro';
---

<Layout
  title="404 — Signal lost · apoi2"
  description="The page you are looking for drifted out of range."
  locale="en"
  noindex
>
  <Nav locale="en" />
  <main id="main" class="relative grid min-h-dvh place-items-center overflow-hidden px-4">
    <!-- signal rain -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      {
        Array.from({ length: 26 }).map((_, i) => (
          <span
            class="rain-glyph"
            style={`left:${(Math.random() * 100).toFixed(1)}%;animation-delay:${(Math.random() * 4).toFixed(2)}s;animation-duration:${(2.4 + Math.random() * 2.6).toFixed(2)}s;color:${['var(--color-violet)', 'var(--color-cyan)', 'var(--color-lilac)'][i % 3]};opacity:${(0.25 + Math.random() * 0.45).toFixed(2)}`}
          >
            {['✦', '0', '1', '·', '▁', '▂', '▃'][i % 7]}
          </span>
        ))
      }
    </div>
    <div class="text-center">
      <p class="font-mono text-[clamp(5rem,18vw,11rem)] leading-none font-bold text-grad">
        404
      </p>
      <h1 class="mt-2 text-2xl font-extrabold tracking-tight text-ink md:text-3xl">
        Signal lost
      </h1>
      <p class="mt-3 text-sm text-soft">
        The page you are looking for drifted out of range.
      </p>
      <p class="mt-1 text-sm text-faint">
        La página que buscas se salió de rango.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="glow-violet inline-flex items-center gap-2 rounded-full bg-violet px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-lilac"
          data-cursor="hover">
          <Icon name="arrow-right" class="size-4 rotate-180" />
          Back home
        </a>
        <a
          href="/es/"
          class="inline-flex items-center gap-2 rounded-full border border-line-strong px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-lilac hover:text-lilac"
          data-cursor="hover">
          Inicio (ES)
        </a>
      </div>
    </div>
  </main>
  <Footer locale="en" />
</Layout>

<style>
  .rain-glyph {
    position: absolute;
    top: -6%;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1;
    animation: fall linear infinite;
  }
  @keyframes fall {
    to {
      transform: translateY(110vh);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rain-glyph {
      display: none;
    }
  }
</style>
