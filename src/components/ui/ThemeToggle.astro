---
/**
 * Premium sun/moon morph toggle (sonner-style): dark shows the sun
 * (switch to light), light shows the moon — the disc gets bitten by
 * a sliding mask circle while the rays retract. Pure CSS morph,
 * state on <html data-theme>, persisted by the toggle script.
 */
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  type="button"
  class="theme-toggle group relative grid size-9 place-items-center overflow-hidden rounded-full border border-line bg-raised transition-colors duration-300 hover:border-line-strong"
  aria-label={label}
  aria-pressed="false"
  data-cursor="hover"
>
  <svg viewBox="0 0 24 24" class="size-[18px] text-ink" aria-hidden="true">
    <mask id="theme-icon-mask">
      <rect x="0" y="0" width="24" height="24" fill="#fff"></rect>
      <circle class="theme-mask" cx="30" cy="-6" r="8.5" fill="#000"></circle>
    </mask>
    <circle
      cx="12"
      cy="12"
      r="5"
      fill="currentColor"
      mask="url(#theme-icon-mask)"></circle>
    <g
      class="theme-rays"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    >
      <path
        d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19"
      ></path>
    </g>
  </svg>
</button>

<style>
  .theme-mask {
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global([data-theme='dark']) .theme-mask {
    transform: translate(0, 0);
  }
  :global([data-theme='light']) .theme-mask {
    transform: translate(-16.5px, 13.5px);
  }
  .theme-rays {
    transform-origin: 12px 12px;
    transition:
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
  }
  :global([data-theme='light']) .theme-rays {
    transform: scale(0.45);
    opacity: 0;
  }
</style>

<script>
  const init = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
    const sync = () => {
      const light = document.documentElement.dataset.theme === 'light';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(light)));
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('apoi2-theme', next);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', next === 'light' ? '#f4f4f9' : '#06060b');
        document.dispatchEvent(
          new CustomEvent('themechange', { detail: { theme: next } }),
        );
        sync();
      }),
    );
    sync();
  };
  document.addEventListener('astro:page-load', init);
</script>
