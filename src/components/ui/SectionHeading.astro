---
/** Section opener: mono kicker + huge display title (slot allows .text-grad spans). */
interface Props {
  kicker: string;
  index?: string;
  class?: string;
}
const { kicker, index, class: className = '' } = Astro.props;
---

<div class={className}>
  <p class="mono-label flex items-center gap-2.5" data-reveal>
    <span class="inline-block size-1.5 rotate-45 bg-violet"></span>
    {kicker}
    {index && <span class="text-violet/70">/ {index}</span>}
  </p>
  <h2
    class="mt-5 max-w-3xl text-4xl font-extrabold leading-[0.98] tracking-tight md:text-6xl"
    data-reveal
    data-reveal-delay="0.08"
  >
    <slot />
  </h2>
</div>
