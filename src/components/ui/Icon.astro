const PATHS = STROKE;

const FILL_ONLY = new Set(['github', 'linkedin', 'bluesky']);
const VIEWBOX: Record<string, string> = {
  linkedin: '0 0 256 256',
  bluesky: '0 0 256 226',
};

const { name, class: className = 'size-5' } = Astro.props;
const paths = PATHS[name];
const isFill = FILL_ONLY.has(name as string);
const vb = VIEWBOX[name as string] ?? '0 0 24 24';
---

<svg
  viewBox={vb}
  class={className}
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width={isFill ? undefined : '1.8'}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...(name === 'linkedin' || name === 'bluesky' ? { preserveAspectRatio: 'xMidYMid' } : {})}
>
  {paths.map((d) => <path d={d} />)}
</svg>
