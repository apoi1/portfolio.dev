---
/** Tech-tag — reads like an instrument value, not a shout. */
interface Props {
  label: string;
  tone?: 'default' | 'violet' | 'cyan' | 'mint' | 'amber' | 'rose';
}
const { label, tone = 'default' } = Astro.props;

const tones: Record<string, string> = {
  default: 'text-soft border-line',
  violet: 'text-lilac border-violet/35',
  cyan: 'text-cyan border-cyan/35',
  mint: 'text-mint border-mint/35',
  amber: 'text-amber border-amber/35',
  rose: 'text-rose border-rose/35',
};
---

<span
  class={`inline-flex items-center rounded-md border bg-base/60 px-2 py-0.5 font-mono text-[11px] ${tones[tone]}`}
>{label}</span>
