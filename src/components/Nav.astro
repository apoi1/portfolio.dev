---
import Icon from './ui/Icon.astro';
import LangToggle from './ui/LangToggle.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { altPath, IDENTITY, type Locale } from '../lib/site';
import { getUI } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getUI(locale);

const path = Astro.url.pathname;
const base = locale === 'es' ? '/es' : '';
const homeHref = locale === 'es' ? '/es/' : '/';
const onHome = path === '/' || path === '/es' || path === '/es/';
const hash = (id: string) => (onHome ? `#${id}` : `${base}/#${id}`);

const links = [
  { id: 'about', label: t.nav.about },
  { id: 'experience', label: t.nav.experience },
  { id: 'projects', label: t.nav.projects },
  { id: 'skills', label: t.nav.skills },
  { id: 'contact', label: t.nav.contact },
];

const socials = [
  { href: IDENTITY.github, icon: 'github' as const, label: 'GitHub' },
  { href: IDENTITY.linkedin, icon: 'linkedin' as const, label: 'LinkedIn' },
  { href: IDENTITY.bluesky, icon: 'bluesky' as const, label: 'Bluesky' },
];
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50">
  <div
    id="nav-bar"
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 transition-colors duration-300 md:px-6"
  >
    <a
      href={homeHref}
      class="group flex items-center gap-2.5"
      aria-label="apoi2 — home"
      data-cursor="hover"
    >
      <span
        class="grid size-8 place-items-center rounded-lg border border-line bg-raised transition-transform duration-300 group-hover:scale-105"
      >
        <Icon name="signal" class="size-4 text-lilac" />
      </span>
      <span class="font-mono text-sm font-bold tracking-tight text-ink"
        >apoi<span class="text-grad">2</span></span
      >
    </a>

    <nav class="hidden md:block" aria-label={t.nav.menu}>
      <ul class="flex items-center gap-7 text-sm text-soft">
        {
          links.map((l) => (
            <li>
              <a
                class="link-line transition-colors hover:text-ink"
                data-nav-link={`#${l.id}`}
                href={hash(l.id)}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LangToggle
        locale={locale}
        enHref={altPath(path, 'en')}
        esHref={altPath(path, 'es')}
      />
      <ThemeToggle label={t.nav.theme} />
      <button
        id="cmdk-btn"
        class="glass hidden h-9 items-center gap-1.5 rounded-full border border-line px-3 font-mono text-[11px] text-soft transition-colors hover:border-line-strong hover:text-ink md:flex"
        aria-label={t.nav.cmdk}
        title={t.nav.cmdk}
        data-cursor="hover"
      >
        <Icon name="command" class="size-3.5" />
        K
      </button>
      <button
        id="burger"
        class="grid size-9 place-items-center rounded-full border border-line text-ink md:hidden"
        aria-label={t.nav.menu}
        aria-expanded="false"
        data-cursor="hover"
      >
        <span class="burger-box relative block h-3 w-4">
          <span class="burger-line absolute inset-x-0 top-0 h-px bg-current"></span>
          <span class="burger-line absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-current"></span>
          <span class="burger-line absolute inset-x-0 bottom-0 h-px bg-current"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- mobile menu -->
  <div
    id="mobile-menu"
    class="invisible fixed inset-0 z-[-1] flex h-dvh flex-col justify-center px-8 opacity-0 transition-all duration-300 md:hidden"
    aria-hidden="true"
  >
    <nav aria-label={t.nav.menu}>
      <ul class="flex flex-col">
        {
          links.map((l) => (
            <li class="border-b border-line">
              <a
                class="mobile-link block py-4 text-3xl font-extrabold tracking-tight text-ink transition-colors hover:text-lilac"
                href={hash(l.id)}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mt-8 flex items-center gap-4">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            class="grid size-10 place-items-center rounded-full border border-line text-soft transition-colors hover:border-lilac hover:text-lilac"
            aria-label={s.label}
          >
            <Icon name={s.icon} class="size-4.5" />
          </a>
        ))
      }
    </div>
  </div>

  <div
    id="scroll-progress"
    class="absolute bottom-0 left-0 h-0.5 w-full origin-left scale-x-0 bg-gradient-to-r from-lilac via-violet to-cyan"
    aria-hidden="true"
  >
  </div>
</header>

<style>
  #nav-bar {
    border-bottom: 1px solid transparent;
  }
  #nav-bar.nav-solid {
    background: var(--glass-bg);
    backdrop-filter: blur(18px) saturate(1.35);
    -webkit-backdrop-filter: blur(18px) saturate(1.35);
    border-bottom-color: var(--color-line);
  }
  .burger-line {
    transition: transform 0.3s var(--ease-out-expo), opacity 0.2s;
  }
  #burger.open .burger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #burger.open .burger-line:nth-child(2) {
    opacity: 0;
  }
  #burger.open .burger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  let scrollBound = false;
  const onScroll = () => {
    const bar = document.getElementById('nav-bar');
    const prog = document.getElementById('scroll-progress');
    const y = window.scrollY;
    bar?.classList.toggle('nav-solid', y > 24);
    if (prog) {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      prog.style.transform = `scaleX(${h > 0 ? Math.min(1, y / h) : 0})`;
    }
  };

  const init = () => {
    if (!scrollBound) {
      scrollBound = true;
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    onScroll();

    // mobile menu
    const burger = document.getElementById('burger');
    const menu = document.getElementById('mobile-menu');
    const toggle = (open: boolean) => {
      if (!burger || !menu) return;
      burger.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', String(open));
      menu.style.opacity = open ? '1' : '0';
      menu.style.visibility = open ? 'visible' : 'hidden';
      menu.style.zIndex = open ? '40' : '-1';
      menu.style.background = 'var(--glass-bg)';
      menu.style.backdropFilter = 'blur(24px) saturate(1.4)';
      menu.style.webkitBackdropFilter = 'blur(24px) saturate(1.4)';
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    burger?.addEventListener('click', () =>
      toggle(!burger.classList.contains('open')),
    );
    menu
      ?.querySelectorAll('a')
      .forEach((a) => a.addEventListener('click', () => toggle(false)));

    // active section highlight (home sections only)
    const sections = document.querySelectorAll('main section[id]');
    const navLinks = document.querySelectorAll('[data-nav-link]');
    if (sections.length > 0 && navLinks.length > 0) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const id = `#${(e.target as HTMLElement).id}`;
            navLinks.forEach((l) => {
              const a = l as HTMLAnchorElement;
              if (a.getAttribute('data-nav-link') === id) {
                a.setAttribute('aria-current', 'true');
                a.classList.add('!text-ink');
              } else {
                a.removeAttribute('aria-current');
                a.classList.remove('!text-ink');
              }
            });
          });
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      sections.forEach((s) => io.observe(s));
    }
  };

  document.addEventListener('astro:page-load', init);
</script>
