---
interface Props {
    image: string[];
    alt: string;
    id: string;
}

const { image, alt, id } = Astro.props;
---

<div class="custom-portfolio-carousel relative w-full rounded-xl overflow-hidden shadow-2xl shadow-white/5" data-id={id}>
    <!-- Carousel wrapper -->
    <div class="relative h-56 overflow-hidden md:h-96">
        {
            image.map((img: string, index: number) => {
                const isActive = index === 0;
                return (
                    <div 
                        class={`absolute inset-0 w-full h-full transition-all duration-700 ease-in-out transform ${
                            isActive 
                            ? "opacity-100 translate-x-0 z-10" 
                            : "opacity-0 translate-x-full z-0"
                        }`}
                        data-carousel-item
                    >
                        <img 
                            src={img} 
                            class="w-full h-full object-cover" 
                            alt={`${alt} - Imagen ${index + 1}`} 
                        />
                    </div>
                );
            })
        }
    </div>
    
    <!-- Slider indicators -->
    <div class="absolute z-30 flex -translate-x-1/2 space-x-3 bottom-5 left-1/2">
        {image.map((_, index: number) => (
            <button 
                type="button" 
                class={`w-3 h-3 rounded-full transition-all duration-300 ${index === 0 ? "bg-white scale-110" : "bg-white/40"}`} 
                data-slide-to={index}>
            </button>
        ))}
    </div>

    <!-- Slider controls -->
    <button type="button" class="absolute top-0 start-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none" data-carousel-prev>
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-black/30 group-hover:bg-black/50 group-focus:ring-4 group-focus:ring-white/20 focus:outline-none">
            <svg class="w-5 h-5 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 19-7-7 7-7"/></svg>
            <span class="sr-only">Previous</span>
        </span>
    </button>
    <button type="button" class="absolute top-0 end-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none" data-carousel-next>
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-black/30 group-hover:bg-black/50 group-focus:ring-4 group-focus:ring-white/20 focus:outline-none">
            <svg class="w-5 h-5 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7"/></svg>
            <span class="sr-only">Next</span>
        </span>
    </button>
</div>

<script>
    function initNativeCarousels() {
        const carousels = document.querySelectorAll('.custom-portfolio-carousel');
        
        carousels.forEach(carousel => {
            const items = carousel.querySelectorAll('[data-carousel-item]');
            const indicators = carousel.querySelectorAll('[data-slide-to]');
            const prevBtn = carousel.querySelector('[data-carousel-prev]');
            const nextBtn = carousel.querySelector('[data-carousel-next]');
            
            let currentIndex = 0;
            const totalItems = items.length;
            if (totalItems <= 1) return;

            function updateCarousel(nextIndex: number, direction: 'next' | 'prev' = 'next') {
                items.forEach((item, i) => {
                    item.classList.remove('opacity-100', 'translate-x-0', 'z-10', 'translate-x-full', '-translate-x-full', 'opacity-0', 'z-0');
                    
                    if (i === nextIndex) {
                        item.classList.add('opacity-100', 'translate-x-0', 'z-10');
                    } else {
                        item.classList.add('opacity-0', 'z-0');
                        if (direction === 'next') {
                            item.classList.add(i < nextIndex ? '-translate-x-full' : 'translate-x-full');
                        } else {
                            item.classList.add(i > nextIndex ? 'translate-x-full' : '-translate-x-full');
                        }
                    }
                });

                indicators.forEach((indicator, i) => {
                    if (i === nextIndex) {
                        indicator.classList.add('bg-white', 'scale-110');
                        indicator.classList.remove('bg-white/40');
                    } else {
                        indicator.classList.remove('bg-white', 'scale-110');
                        indicator.classList.add('bg-white/40');
                    }
                });

                currentIndex = nextIndex;
            }

            prevBtn?.addEventListener('click', () => {
                let targetIndex = currentIndex - 1;
                if (targetIndex < 0) targetIndex = totalItems - 1;
                updateCarousel(targetIndex, 'prev');
            });

            nextBtn?.addEventListener('click', () => {
                let targetIndex = currentIndex + 1;
                if (targetIndex >= totalItems) targetIndex = 0;
                updateCarousel(targetIndex, 'next');
            });

            indicators.forEach((indicator, i) => {
                indicator.addEventListener('click', () => {
                    if (i === currentIndex) return;
                    const dir = i > currentIndex ? 'next' : 'prev';
                    updateCarousel(i, dir);
                });
            });
        });
    }

    initNativeCarousels();
    document.addEventListener('astro:page-load', initNativeCarousels);
</script>