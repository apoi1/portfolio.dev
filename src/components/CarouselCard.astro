---
const { img, alt, active } = Astro.props
---

<div class="hidden duration-700 ease-in-out" data-carousel-item={active ? "active" : true}>
    <img 
        src={img}
        class="absolute block w-full h-full object-cover -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
        alt={alt}
    >
</div>