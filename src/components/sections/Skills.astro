---
/**
 * Skills — bento of five category cards + a live-looking terminal card.
 * Items are evidence-backed only (stacks that shipped in real projects).
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../lib/site';
import { getUI } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getUI(locale);

// terminal lines come as [command, output, command, output, ...]
const term = t.skills.terminal.lines;
const pairs: Array<{ cmd: string; out?: string }> = [];
for (let i = 0; i < term.length; i += 2) {
  pairs.push({ cmd: term[i], out: term[i + 1] });
}
---

<section id="skills" class="relative scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-24 md:px-6 md:py-36">
    <SectionHeading kicker={t.skills.kicker} index="04">
      {t.skills.titleLead}
      <span class="text-grad">{t.skills.titleGrad}</span>
    </SectionHeading>

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <!-- terminal card spans the last column on lg -->
      <div class="frame overflow-hidden rounded-2xl lg:col-span-1" data-reveal>
        <div class="flex items-center gap-2 border-b border-line px-4 py-3">
          <span class="size-2.5 rounded-full bg-rose"></span>
          <span class="size-2.5 rounded-full bg-amber"></span>
          <span class="size-2.5 rounded-full bg-mint"></span>
          <span class="mono-label ml-2 !text-faint">apoi2@bogota:~</span>
        </div>
        <div class="space-y-2 p-5 font-mono text-xs md:text-[13px]" data-stagger>
          {
            pairs.map((p) => (
              <>
                <p class="text-ink">
                  <span class="mr-2 text-violet">$</span>
                  {p.cmd}
                </p>
                {p.out && <p class="pl-4 text-soft">{p.out}</p>}
              </>
            ))
          }
          <p class="text-ink">
            <span class="mr-2 text-violet">$</span>
            <span class="animate-blink text-lilac">▌</span>
          </p>
        </div>
      </div>

      {
        t.skills.groups.map((g) => (
          <div class="frame rounded-2xl p-6" data-reveal>
            <div class="flex items-center gap-3">
              <span class="grid size-9 place-items-center rounded-xl border border-line bg-base text-lilac">
                <Icon name={g.icon as any} class="size-4.5" />
              </span>
              <h3 class="font-bold text-ink">{g.title}</h3>
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              {g.items.map((item) => (
                <Chip label={item} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
