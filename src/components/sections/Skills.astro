---
/**
 * Skills — a REAL interactive terminal beside one instrument panel of
 * "channels". Visitors can type commands: help, whoami, projects,
 * contact, email (copies!), theme (toggles!), lang (navigates!), konami,
 * sudo, clear.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Chip from '../ui/Chip.astro';
import { getUI } from '../../i18n/ui';
import type { Locale } from '../../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getUI(locale);

// terminal intro lines come as [command, output, command, output, ...]
const term = t.skills.terminal.lines;
const pairs: Array<{ cmd: string; out?: string }> = [];
for (let i = 0; i < term.length; i += 2) {
  pairs.push({ cmd: term[i], out: term[i + 1] });
}
---

<section id="skills" class="relative scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-24 md:px-6 md:py-36">
    <SectionHeading lead={t.skills.titleLead} grad={t.skills.titleGrad} />

    <div class="mt-14 grid gap-6 lg:grid-cols-[5fr_7fr] lg:gap-8">
      <!-- terminal -->
      <div class="frame overflow-hidden rounded-2xl" data-reveal>
        <div class="flex items-center gap-2 border-b border-line px-4 py-3">
          <span class="size-2.5 rounded-full bg-rose"></span>
          <span class="size-2.5 rounded-full bg-amber"></span>
          <span class="size-2.5 rounded-full bg-mint"></span>
          <span class="mono-label ml-2 !text-faint">apoi2@bogota:~</span>
        </div>
        <div
          id="term-body"
          class="max-h-56 space-y-2 overflow-y-auto p-5 font-mono text-xs md:text-[13px]"
          data-stagger
        >
          {
            pairs.map((p) => (
              <>
                <p class="text-ink">
                  <span class="mr-2 text-violet">apoi2@bogota:~$</span>
                  {p.cmd}
                </p>
                {p.out && <p class="pl-4 text-soft">{p.out}</p>}
              </>
            ))
          }
        </div>
        <div
          class="flex items-center gap-2 border-t border-line px-5 py-3 font-mono text-xs md:text-[13px]"
        >
          <span class="shrink-0 text-violet">apoi2@bogota:~$</span>
          <input
            id="term-input"
            class="min-w-0 flex-1 bg-transparent text-ink caret-violet outline-none placeholder:text-faint"
            placeholder={t.skills.terminal.hint}
            autocomplete="off"
            spellcheck="false"
            aria-label="terminal"
          />
        </div>
      </div>

      <!-- channels panel -->
      <div
        class="frame flex flex-col divide-y divide-line rounded-2xl px-6 py-4 md:px-8"
        data-stagger
      >
        {
          t.skills.groups.map((g) => (
            <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2.5 py-4 first:pt-3 last:pb-3">
              <p class="w-30 shrink-0 font-mono text-xs text-faint">{g.title}</p>
              <div class="flex flex-wrap gap-1.5">
                {g.items.map((item) => (
                  <Chip label={item} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { getUI } from '../../i18n/ui';
  import { cycleMotion } from '../../scripts/motion-pref';

  const init = () => {
    const input = document.getElementById('term-input') as HTMLInputElement | null;
    const body = document.getElementById('term-body');
    if (!input || !body) return;

    const locale = document.documentElement.lang === 'es' ? ('es' as const) : ('en' as const);
    const out = getUI(locale).skills.terminal.out;

    const print = (cmd: string, text: string, ok = false) => {
      const c = document.createElement('p');
      c.className = 'text-ink';
      const d = document.createElement('span');
      d.className = 'mr-2 text-violet';
      d.textContent = 'apoi2@bogota:~$';
      c.append(d, document.createTextNode(cmd));
      const o = document.createElement('p');
      o.className = `pl-4 ${ok ? 'text-mint' : 'text-soft'} whitespace-pre-line`;
      o.textContent = text;
      body.append(c, o);
      body.scrollTop = body.scrollHeight;
    };

    const historyArr: string[] = [];
    const projSlugs = [...document.querySelectorAll<HTMLElement>('[data-cmdk-item]')]
      .map((el) => ((el.dataset.href ?? '').match(/projects\/([^/]+)\//) ?? [])[1])
      .filter((s): s is string => !!s);
    let lastTab = { val: '', at: 0 };

    input.addEventListener('keydown', async (e) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        const val = input.value;
        const hasSpace = /\s/.test(val.trim());
        const head = hasSpace ? val.slice(0, val.indexOf(' ')) : '';
        const frag = (hasSpace ? val.slice(val.indexOf(' ') + 1) : val).toLowerCase();
        const pool =
          hasSpace && head.toLowerCase() === 'cd'
            ? ['about', 'experience', 'projects', 'skills', 'contact', ...projSlugs, '~', '..', 'home']
            : hasSpace && head.toLowerCase() === 'cat'
              ? ['status.txt', 'contact.txt', 'cv.txt']
              : hasSpace && head.toLowerCase() === 'open'
                ? ['github', 'linkedin', 'bluesky', 'cv']
                : ['cd', 'ls', 'cat', 'help', 'whoami', 'pwd', 'history', 'uname', 'open', 'projects', 'contact', 'email', 'theme', 'lang', 'konami', 'sudo', 'clear', 'exit'];
        const matches = pool.filter((c) => c.startsWith(frag));
        if (matches.length === 0) return;
        let chosen = matches[0];
        if (matches.length > 1) {
          for (const m of matches) {
            while (!m.startsWith(chosen)) chosen = chosen.slice(0, -1);
          }
        }
        input.value = (hasSpace ? head + ' ' : '') + chosen;
        if (matches.length === 1) input.value += ' ';
        else {
          // real double-Tab: no further progress → list the options
          const now = performance.now();
          if (lastTab.val === input.value && now - lastTab.at < 1500) {
            print('tab', matches.join('   '));
          }
          lastTab = { val: input.value, at: now };
        }
        return;
      }
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const raw = input.value.trim();
      input.value = '';
      if (!raw) return;
      if (historyArr.length >= 50) historyArr.shift();
      historyArr.push(raw);
      const cmd = raw.toLowerCase().split(/\s+/)[0];

      if (cmd === 'cd') {
        const target = raw.replace(/^\S+\s*/, '').trim().toLowerCase();
        if (target === '' || target === 'home' || target === '~' || target === '..') {
          print(raw, '→ /', true);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else if (['about', 'experience', 'projects', 'skills', 'contact'].includes(target)) {
          print(raw, `→ #${target}`, true);
          document.getElementById(target)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else if (projSlugs.includes(target)) {
          const base = locale === 'es' ? '/es/projects/' : '/projects/';
          print(raw, `→ ${base}${target}/`, true);
          window.setTimeout(() => {
            window.location.href = `${base}${target}/`;
          }, 400);
        } else {
          print(raw, out.cdNotFound);
        }
        return;
      }
      if (cmd === 'ls') {
        print(raw, out.ls);
        return;
      }
      if (cmd === 'pwd') {
        print(raw, out.pwd);
        return;
      }
      if (cmd === 'history') {
        print(
          raw,
          historyArr.length
            ? historyArr.map((h, i) => `${String(i + 1).padStart(3)}  ${h}`).join('\n')
            : out.historyEmpty,
        );
        return;
      }
      if (cmd === 'cat') {
        const file = raw.replace(/^\S+\s*/, '').trim().toLowerCase();
        if (!file) print(raw, out.catUsage);
        else if (file === 'status.txt') print(raw, out.fileStatus);
        else if (file === 'contact.txt') print(raw, out.fileContact);
        else if (file === 'cv.txt') print(raw, out.fileCv);
        else print(raw, out.catMissing.replace('{f}', file));
        return;
      }
      if (cmd === 'open') {
        const target = raw.replace(/^\S+\s*/, '').trim().toLowerCase().replace(/\s+/g, '');
        if (!target) {
          print(raw, out.openUsage);
          return;
        }
        if (target === 'cv') {
          const cvHref = locale === 'es' ? '/es/cv' : '/cv';
          print(raw, `→ ${cvHref}`, true);
          window.setTimeout(() => {
            window.location.href = cvHref;
          }, 400);
          return;
        }
        const found = [...document.querySelectorAll<HTMLElement>('[data-cmdk-item]')].find(
          (el) =>
            (el.dataset.label ?? '').toLowerCase().replace(/\s+/g, '') === target,
        );
        if (found?.dataset.href) {
          const href = found.dataset.href;
          print(raw, `→ ${href}`, true);
          window.setTimeout(() => {
            if (found.dataset.external === 'true') window.open(href, '_blank', 'noopener');
            else window.location.href = href;
          }, 400);
          return;
        }
        print(raw, out.openMissing.replace('{f}', target));
        return;
      }
      if (cmd === 'uname') {
        print(raw, out.uname);
        return;
      }
      if (cmd === 'exit' || cmd === 'logout') {
        print(raw, out.exitLine);
        return;
      }

      if (cmd === 'motion') {
        print(raw, out.motion);
        window.setTimeout(() => cycleMotion(), 350);
        return;
      }
      if (cmd === 'clear') {
        body.replaceChildren();
        return;
      }
      const text = (out as Record<string, string>)[cmd] ?? out.unknown;
      print(raw, text);

      if (cmd === 'email') {
        try {
          await navigator.clipboard.writeText('apoi2@proton.me');
        } catch {}
        (window as any).__toast?.(text);
      }
      if (cmd === 'sudo') {
        (window as any).__toast?.(text);
        window.setTimeout(() => {
          window.location.href = 'mailto:apoi2@proton.me?subject=sudo%20hire%20apoi2';
        }, 700);
      }
      if (cmd === 'theme') {
        const next =
          document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('apoi2-theme', next);
        } catch {}
        document.dispatchEvent(
          new CustomEvent('themechange', { detail: { theme: next } }),
        );
      }
      if (cmd === 'lang') {
        window.setTimeout(() => {
          window.location.href = locale === 'es' ? '/' : '/es/';
        }, 500);
      }
    });
  };
  document.addEventListener('astro:page-load', init);
</script>
