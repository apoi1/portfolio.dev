---
/**
 * Skills — a REAL interactive terminal beside one instrument panel of
 * "channels". Visitors can type commands: help, whoami, projects,
 * contact, email (copies!), theme (toggles!), lang (navigates!), konami,
 * sudo, clear.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Chip from '../ui/Chip.astro';
import { getUI } from '../../i18n/ui';
import type { Locale } from '../../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getUI(locale);

// terminal intro lines come as [command, output, command, output, ...]
const term = t.skills.terminal.lines;
const pairs: Array<{ cmd: string; out?: string }> = [];
for (let i = 0; i < term.length; i += 2) {
  pairs.push({ cmd: term[i], out: term[i + 1] });
}
---

<section id="skills" class="relative scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-24 md:px-6 md:py-36">
    <SectionHeading lead={t.skills.titleLead} grad={t.skills.titleGrad} />

    <div class="mt-14 grid gap-6 lg:grid-cols-[5fr_7fr] lg:gap-8">
      <!-- terminal -->
      <div class="frame overflow-hidden rounded-2xl" data-reveal>
        <div class="flex items-center gap-2 border-b border-line px-4 py-3">
          <span class="size-2.5 rounded-full bg-rose"></span>
          <span class="size-2.5 rounded-full bg-amber"></span>
          <span class="size-2.5 rounded-full bg-mint"></span>
          <span class="mono-label ml-2 !text-faint">apoi2@bogota:~</span>
        </div>
        <div
          id="term-body"
          class="max-h-56 space-y-2 overflow-y-auto p-5 font-mono text-xs md:text-[13px]"
          data-stagger
        >
          {
            pairs.map((p) => (
              <>
                <p class="text-ink">
                  <span class="mr-2 text-violet">apoi2@bogota:~$</span>
                  {p.cmd}
                </p>
                {p.out && <p class="pl-4 text-soft">{p.out}</p>}
              </>
            ))
          }
        </div>
        <div
          class="flex items-center gap-2 border-t border-line px-5 py-3 font-mono text-xs md:text-[13px]"
        >
          <span class="shrink-0 text-violet">apoi2@bogota:~$</span>
          <input
            id="term-input"
            class="min-w-0 flex-1 bg-transparent text-ink caret-violet outline-none placeholder:text-faint"
            placeholder={t.skills.terminal.hint}
            autocomplete="off"
            spellcheck="false"
            aria-label="terminal"
          />
        </div>
      </div>

      <!-- channels panel -->
      <div
        class="frame flex flex-col divide-y divide-line rounded-2xl px-6 py-4 md:px-8"
        data-stagger
      >
        {
          t.skills.groups.map((g) => (
            <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2.5 py-4 first:pt-3 last:pb-3">
              <p class="w-30 shrink-0 font-mono text-xs text-faint">{g.title}</p>
              <div class="flex flex-wrap gap-1.5">
                {g.items.map((item) => (
                  <Chip label={item} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { getUI } from '../../i18n/ui';

  const init = () => {
    const input = document.getElementById('term-input') as HTMLInputElement | null;
    const body = document.getElementById('term-body');
    if (!input || !body) return;

    const locale = document.documentElement.lang === 'es' ? ('es' as const) : ('en' as const);
    const out = getUI(locale).skills.terminal.out;

    const print = (cmd: string, text: string, ok = false) => {
      const c = document.createElement('p');
      c.className = 'text-ink';
      const d = document.createElement('span');
      d.className = 'mr-2 text-violet';
      d.textContent = 'apoi2@bogota:~$';
      c.append(d, document.createTextNode(cmd));
      const o = document.createElement('p');
      o.className = `pl-4 ${ok ? 'text-mint' : 'text-soft'}`;
      o.textContent = text;
      body.append(c, o);
      body.scrollTop = body.scrollHeight;
    };

    input.addEventListener('keydown', async (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const raw = input.value.trim();
      input.value = '';
      if (!raw) return;
      const cmd = raw.toLowerCase().split(/\s+/)[0];

      if (cmd === 'cd') {
        const target = raw.replace(/^\S+\s*/, '').trim().toLowerCase();
        if (target === '' || target === 'home' || target === '~' || target === '..') {
          print(raw, '→ /', true);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else if (['about', 'experience', 'projects', 'skills', 'contact'].includes(target)) {
          print(raw, `→ #${target}`, true);
          document.getElementById(target)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          print(raw, out.cdNotFound);
        }
        return;
      }
      if (cmd === 'ls') {
        print(raw, out.ls);
        return;
      }

      if (cmd === 'clear') {
        body.replaceChildren();
        return;
      }
      const text = (out as Record<string, string>)[cmd] ?? out.unknown;
      print(raw, text);

      if (cmd === 'email') {
        try {
          await navigator.clipboard.writeText('apoi2@proton.me');
        } catch {}
        (window as any).__toast?.(text);
      }
      if (cmd === 'sudo') {
        (window as any).__toast?.(text);
        window.setTimeout(() => {
          window.location.href = 'mailto:apoi2@proton.me?subject=sudo%20hire%20apoi2';
        }, 700);
      }
      if (cmd === 'theme') {
        const next =
          document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('apoi2-theme', next);
        } catch {}
        document.dispatchEvent(
          new CustomEvent('themechange', { detail: { theme: next } }),
        );
      }
      if (cmd === 'lang') {
        window.setTimeout(() => {
          window.location.href = locale === 'es' ? '/' : '/es/';
        }, 500);
      }
    });
  };
  document.addEventListener('astro:page-load', init);
</script>
