---
/**
 * About — portrait with floating badges + verified bio + animated stat counters.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { Image } from 'astro:assets';
import photo from '../../assets/photo.jpg';
import type { Locale } from '../../lib/site';
import { getUI } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getUI(locale);
const testsLabel = locale === 'es' ? '527 pruebas' : '527 tests';
---

<section id="about" class="relative scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-24 md:px-6 md:py-36">
    <SectionHeading lead={t.about.titleLead} grad={t.about.titleGrad} />

    <div
      class="mt-14 grid items-start gap-14 lg:grid-cols-[5fr_7fr] lg:gap-20"
    >
      <!-- portrait -->
      <div class="relative mx-auto w-full max-w-xs sm:max-w-sm lg:mx-0" data-reveal>
        <div
          class="frame glow-violet overflow-hidden rounded-3xl p-2 transition-transform duration-500 ease-out hover:-rotate-1 hover:scale-[1.02]"
        >
          <Image
            src={photo}
            alt={t.about.photoAlt}
            width={512}
            height={512}
            loading="lazy"
            decoding="async"
            class="aspect-square w-full rounded-2xl object-cover" />
        </div>
        <div
          class="glass absolute -right-3 top-8 animate-float rounded-full border border-line px-3.5 py-1.5 font-mono text-[11px] whitespace-nowrap text-ink"
        >
          <span class="text-mint">✦</span> {testsLabel}
        </div>
        <div
          class="glass absolute -left-3 bottom-10 animate-float rounded-full border border-line px-3.5 py-1.5 font-mono text-[11px] whitespace-nowrap text-ink [animation-delay:1.4s]"
        >
          <Icon name="map-pin" class="mr-1 inline size-3 text-lilac" />
          Bogotá · CO
        </div>
      </div>

      <!-- bio + stats -->
      <div>
        <div class="space-y-5 text-base leading-relaxed text-soft md:text-lg" data-stagger>
          {t.about.bio.map((p) => <p class="text-pretty">{p}</p>)}
        </div>

        <div
          class="frame mt-12 grid grid-cols-2 md:grid-cols-4 md:divide-x md:divide-line"
          data-stagger
        >
          {
            t.about.stats.map((s, i) => (
              <div
                class:list={[
                  'py-5 md:px-7',
                  i % 2 === 0 ? 'pr-6' : 'pl-6 md:pl-7',
                  i === 0 && 'md:pl-7',
                ]}
              >
                <p class="font-mono text-3xl font-bold text-ink md:text-4xl">
                  {typeof s.value === 'number' ? (
                    <span data-counter={s.value} data-suffix={s.suffix}>
                      {s.value}
                    </span>
                  ) : (
                    <span>{s.value}</span>
                  )}
                </p>
                <p class="mt-2 font-mono text-xs text-faint">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
