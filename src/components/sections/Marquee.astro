---
/**
 * Tech marquee — infinite mono strip, slightly tilted, edge-masked.
 * Content is brand names (no translation needed). Duplicated track +
 * translateX(-50%) = seamless loop; hover pauses it.
 */
const items = [
  'Astro',
  'React',
  'TypeScript',
  'Java',
  'Spring Boot',
  'Python',
  'C++ · ESP32',
  'MQTT',
  'Tailwind CSS',
  'SQLite',
  'Docker',
  'GSAP',
  'FFT · DSP',
  'Linux',
  'Firebase',
  'Node.js',
];
const loop = [...items, ...items];
---

<div
  class="relative overflow-hidden border-y border-line bg-raised/40 py-4 mask-x"
  aria-hidden="true"
>
  <div class="flex w-max animate-marquee items-center gap-10 hover:[animation-play-state:paused]">
    {
      loop.map((item) => (
        <span class="flex items-center gap-10">
          <span class="font-mono text-sm tracking-[0.08em] whitespace-nowrap text-soft">
            {item}
          </span>
          <span class="text-xs text-violet">✦</span>
        </span>
      ))
    }
  </div>
</div>
